    #TERMINAN LOS SIMBOLOS DE LA CAPA DE POZOS
    SYMBOL
        NAME 'tent'
        TYPE VECTOR
        FILLED TRUE
        POINTS
            0 1
            .5 0
            1 1
            .75 1
            .5 .5
            .25 1
            0 1
        END #POINTS
    END #SYMBOL
    SYMBOL
        NAME 'tentt'
        TYPE VECTOR
        FILLED TRUE
        POINTS
            1 0
            .5 0
            1 1
            .75 1
            .5 .5
            .25 1
            0 1
        END #POINTS
    END #SYMBOL
    SYMBOL
        NAME 'star'
        TYPE VECTOR
        FILLED TRUE
        POINTS
            0 .375
            .35 .375
            .5 0
            .65 .375
            1 .375
            .75 .625
            .875 1
            .5 .75
            .125 1
            .25 .625
        END #POINTS
    END #SYMBOL
    SYMBOL
        NAME 'triangle'
        TYPE VECTOR
        FILLED TRUE
        POINTS
            0 1
            .5 0
            1 1
            0 1
        END #POINTS
    END #SYMBOL
    SYMBOL
        NAME 'square'
        TYPE VECTOR
        FILLED TRUE
        POINTS
            0 1
            0 0
            1 0
            1 1
            0 1
        END #POINTS
    END #SYMBOL
    SYMBOL
        NAME 'plus'
        TYPE VECTOR
        POINTS
            .5 0
            .5 1
            -99 -99
            0 .5
            1 .5
        END #POINTS
    END #SYMBOL
    SYMBOL
        NAME 'cross'
        TYPE VECTOR
        POINTS
            0 0
            1 1
            -99 -99
            0 1
            1 0
        END #POINTS
    END #SYMBOL
